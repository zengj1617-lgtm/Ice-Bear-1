function setup() {
  createCanvas(400, 400);
}

function draw() {
  background(200);

  // face shape
  fill(255);
  ellipse(200, 400, 300, 600);

  // eyes
  fill(0);
  ellipse(150, 230, 10, 20);
  ellipse(250, 230, 10, 20);

  // nose
  fill(0);
  ellipse(200, 330, 40, 20);

  // mouth
  fill(0);
  rect(170, 370, 65, 5);

  // ears
  fill(255);
  ellipse(120, 140, 50, 50);
  ellipse(280, 140, 50, 50);
}
